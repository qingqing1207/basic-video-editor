    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "culori": "4.0.2",
    "eventemitter3": "5.0.1",
    "lucide-react": "0.562.0",
    "mediabunny": "1.29.1",
    "motion": "12.18.1",
    "nanoid": "5.1.5",
    "react-resizable-panels": "2.1.7",
    "react-window": "2.2.7",
    "soundtouchjs": "0.3.0",
    "tailwind-merge": "3.5.0",
