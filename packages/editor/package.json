{
  "name": "@basic-video-editor/editor",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "files": [
    "dist",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
